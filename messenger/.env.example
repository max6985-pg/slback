# ─────────────────────────────────────────────────────────────
#  onepin 비공개 메신저 설정 (install.sh 가 .env 로 복사해서 사용)
# ─────────────────────────────────────────────────────────────

# 사용자 아이디 뒤에 붙는 도메인 (@hong:onepin.net)
# ⚠ 설치 후에는 절대 바꿀 수 없습니다. 처음에 신중히 정하세요.
SERVER_NAME=onepin.net

# Synapse(메신저 서버) 가 연결될 주소
MATRIX_HOST=matrix.onepin.net

# Element 웹(브라우저용 채팅 화면) 주소
CHAT_HOST=chat.onepin.net

# 화면에 보이는 메신저 이름
BRAND="OnePin 메신저"

# 인증서(Let's Encrypt) 발급 알림을 받을 이메일
ADMIN_EMAIL=admin@onepin.net

# 첫 관리자 계정 아이디 (비밀번호는 설치 중에 입력)
ADMIN_USER=admin

# 서버 내부에서만 쓰는 포트 (CMS 가 쓰는 포트와 겹치면 변경)
SYNAPSE_PORT=8008
ELEMENT_PORT=8088
ADMIN_PORT=8090
JWT_PORT=8070
CALL_PORT=8092

# 통화(음성·영상). CALL_HOST 는 PC 브라우저 통화 화면 주소 — DNS 레코드가 따로 필요합니다.
CALL_HOST=call.onepin.net
# 이 서버의 공인 IP (통화 미디어가 이 주소로 직접 들어옵니다)
NODE_IP=
# 통화 미디어용 UDP 포트 범위 (방화벽에서 열립니다)
LK_UDP_START=50100
LK_UDP_END=50200
# 통화 인증 서비스의 내부 IP (PUSH_SUBNET 안, SYGNAL_IP 와 달라야 함)
LK_JWT_IP=10.250.250.5

# 푸시 알림 (Synapse ↔ Sygnal 내부 네트워크). 서버의 다른 네트워크와 겹칠 때만 변경
PUSH_APP_ID=net.onepin.push
PUSH_SUBNET=10.250.250.0/29
SYGNAL_IP=10.250.250.4

# 업로드 가능한 파일 최대 크기 (Cloudflare 프록시 무료 요금제는 100M 이하)
MAX_UPLOAD_SIZE=100M

# Cloudflare API 토큰 (선택) — 원본 인증서(certs/) 없이 주황 구름에서 Let's Encrypt 를 쓸 때만 필요
# Cloudflare → My Profile → API Tokens → "Edit zone DNS" 템플릿, Zone: onepin.net
CF_API_TOKEN=

# 단체방: 새 계정이 자동으로 들어가는 방 (주소 #all:onepin.net, 방 만들기: scripts/create-group-room.sh)
GROUP_ROOM_ALIAS=all
GROUP_ROOM_NAME=전체공지

# ── 텔레그램 브릿지 (선택) ─────────────────────────────────────
# on 으로 바꾸고 아래 값을 채운 뒤 sudo ./install.sh 를 다시 실행하세요 (README "텔레그램 브릿지")
TELEGRAM_BRIDGE=off
# https://my.telegram.org → API development tools 에서 발급
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 텔레그램 @BotFather 에서 만든 봇 토큰 (릴레이 봇)
TELEGRAM_BOT_TOKEN=
# on: 사용자가 자기 텔레그램 계정으로 로그인 가능 (보안상 off 권장)
TELEGRAM_PUPPETING=off

# 아래 값들은 install.sh 가 자동으로 생성합니다. 비워 두세요.
POSTGRES_PASSWORD=
REGISTRATION_SHARED_SECRET=
MACAROON_SECRET_KEY=
FORM_SECRET=
LK_KEY=
LK_SECRET=
LK_AS_TOKEN=
LK_HS_TOKEN=
